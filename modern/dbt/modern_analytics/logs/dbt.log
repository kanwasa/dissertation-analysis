[0m11:33:48.394560 [debug] [Thread-1 (]: Using postgres connection "model.modern_analytics.stg_online_retail"
[0m11:33:48.395754 [debug] [Thread-1 (]: On model.modern_analytics.stg_online_retail: /* {"app": "dbt", "dbt_version": "1.12.3", "profile_name": "modern_analytics", "target_name": "dev", "node_id": "model.modern_analytics.stg_online_retail"} */

  create view "dissertation_analytics"."modern_dw"."stg_online_retail__dbt_tmp"
    
    
  as (
    with source as (

    select *
    from "dissertation_analytics"."modern_raw"."online_retail_raw"

),

staged as (

    select
        invoice,
        stock_code,
        description,

        case
            when trim(quantity) ~ '^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)$'
            then trim(quantity)::numeric
            else null
        end as quantity,

        case
            when trim(price) ~ '^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)$'
            then trim(price)::numeric
            else null
        end as price,
        

        case
            when invoice_date is null
                or trim(invoice_date) = ''
            then null

            when trim(invoice_date)
                ~ '^[0-9]{2}-[0-9]{2}-[0-9]{4} [0-9]{2}:[0-9]{2}$'
                and to_char(
                    to_timestamp(
                        trim(invoice_date),
                        'DD-MM-YYYY HH24:MI'
                    ),
                    'DD-MM-YYYY HH24:MI'
                ) = trim(invoice_date)
            then to_timestamp(
                trim(invoice_date),
                'DD-MM-YYYY HH24:MI'
            )

            else null
        end as invoice_date,

        customer_id,
        country,

        case
            when invoice like 'C%' then true
            else false
        end as is_cancellation,

        case
            when customer_id is null then true
            else false
        end as missing_customer_flag,

        case
            when description is null then true
            else false
        end as missing_description_flag

    from source

)

select *
from staged
  );
