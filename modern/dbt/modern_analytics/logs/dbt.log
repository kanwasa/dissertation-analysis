  create view "dissertation_analytics"."modern_dw"."cancellations__dbt_tmp"
    
    
  as (
    -- cancellations.sql
select
    count(*) filter (
        where is_cancellation
    ) as cancellation_count,

    round(
        (
            100.0
            * count(*) filter (where is_cancellation)
